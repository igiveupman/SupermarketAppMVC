<%- include('partials/header', { user, pageTitle: 'Subscription Payment', currentPage: 'subscription', messages, errors }) %>
<h2 class="mb-3">Upgrade to <%= tier.name %></h2>
<p class="text-muted mb-4">Confirm your subscription and pay using your preferred method.</p>

<div class="mb-4">
  <div class="card shadow-sm">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <div class="fw-semibold"><%= tier.name %> Plan</div>
        <div class="text-muted small">Monthly subscription</div>
      </div>
      <div class="fs-4 fw-semibold">$<%= priceFormatted %> / month</div>
    </div>
  </div>
</div>

<script src="https://www.paypal.com/sdk/js?client-id=<%= process.env.PAYPAL_CLIENT_ID %>&currency=SGD"></script>
<script src="https://js.stripe.com/v3/"></script>
<form action="/subscription/checkout" method="POST" class="payment-form" id="subscriptionPaymentForm">
  <div class="mb-3">
    <label class="form-label fw-semibold">Payment Method</label>
    <div class="d-flex flex-wrap gap-3">
      <div class="form-check">
        <input class="form-check-input" type="radio" name="method" id="methodStripe" value="stripe" checked>
        <label class="form-check-label" for="methodStripe">Card (Stripe)</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="radio" name="method" id="methodPayNow" value="paynow">
        <label class="form-check-label" for="methodPayNow">PayNow</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="radio" name="method" id="methodNETS" value="nets">
        <label class="form-check-label" for="methodNETS">NETS</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="radio" name="method" id="methodPayPal" value="paypal">
        <label class="form-check-label" for="methodPayPal">PayPal</label>
      </div>
    </div>
  </div>
  <div id="stripeSection" class="border rounded p-3 mb-3 wallet-section" data-method="stripe" style="background:#fff;">
    <div class="mb-2 fw-semibold">Pay with Stripe Checkout</div>
    <p class="small text-muted mb-2">You will be redirected to Stripe’s hosted checkout where you can safely enter your card information.</p>
    <div class="small text-muted">Stripe handles all card details and keeps you within a secure flow.</div>
  </div>
  <div id="paynowSection" class="border rounded p-3 mb-3 wallet-section" data-method="paynow" style="display:none; background:#fff;">
    <p class="mb-2 fw-semibold">PayNow QR payment (Stripe)</p>
    <div class="small text-muted mb-2">Generate a QR code and scan it with your bank app to pay.</div>
    <button type="button" class="btn btn-outline btn-sm" id="subPaynowStartBtn">Confirm Payment</button>
    <div class="mt-3 d-none" id="subPaynowQrWrap">
      <img id="subPaynowQrImage" alt="PayNow QR Code" style="max-width:220px; width:100%; border:1px solid #e2e8f0; border-radius:12px; padding:10px; background:#f8fafc;" />
      <div class="small text-muted mt-2">Or open the instructions: <a href="#" target="_blank" rel="noreferrer" id="subPaynowQrLink">PayNow instructions</a></div>
      <div class="small text-muted mt-1" id="subPaynowExpires"></div>
    </div>
    <div class="small mt-2" id="subPaynowStatus"></div>
  </div>
  <div id="netsSection" class="border rounded p-3 mb-3 wallet-section" data-method="nets" style="display:none; background:#fff;">
    <p class="mb-2 fw-semibold">NETS QR will be generated after you click Confirm Payment.</p>
    <p class="small text-muted mb-0">You will be redirected to a NETS QR page to scan and complete payment.</p>
  </div>
  <div id="paypalSection" class="border rounded p-3 mb-3 wallet-section" data-method="paypal" style="display:none; background:#fff;">
    <p class="mb-2 fw-semibold">Pay with PayPal</p>
    <p class="small text-muted">Complete payment using your PayPal account.</p>
    <div id="paypal-button-container"></div>
  </div>
  <input type="hidden" name="payment_intent" id="stripePaymentIntent" value="" />
  <button type="submit" class="btn btn-primary" id="confirmPaymentBtn"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"></path></svg></span>Confirm Payment</button>
  <a href="/subscription" class="btn btn-outline ms-2"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 6l-6 6 6 6"></path></svg></span>Back to Subscriptions</a>
</form>

<script>
  (function(){
    const stripeRadio = document.getElementById('methodStripe');
    const paynowRadio = document.getElementById('methodPayNow');
    const netsRadio = document.getElementById('methodNETS');
    const paypalRadio = document.getElementById('methodPayPal');
    const walletSections = document.querySelectorAll('.wallet-section');
    const confirmBtn = document.getElementById('confirmPaymentBtn');
    const paypalContainer = document.getElementById('paypal-button-container');
    const subPaynowStartBtn = document.getElementById('subPaynowStartBtn');
    const subPaynowQrWrap = document.getElementById('subPaynowQrWrap');
    const subPaynowQrImage = document.getElementById('subPaynowQrImage');
    const subPaynowQrLink = document.getElementById('subPaynowQrLink');
    const subPaynowStatus = document.getElementById('subPaynowStatus');
    const subPaynowExpires = document.getElementById('subPaynowExpires');
    const stripeKey = "<%= process.env.STRIPE_PUBLISHABLE_KEY || '' %>";
    const stripeIntentInput = document.getElementById('stripePaymentIntent');
    const paymentForm = document.getElementById('subscriptionPaymentForm');
    let stripeInstance = null;
    let paypalRendered = false;

    if (stripeKey) {
      stripeInstance = Stripe(stripeKey);
    } else {
      stripeRadio.disabled = true;
      stripeRadio.checked = false;
      paynowRadio.checked = true;
      document.getElementById('stripeSection').innerHTML = '<div class="text-danger small">Stripe is not configured.</div>';
    }

    function renderPaypalButtons() {
      if (paypalRendered || !window.paypal || !paypalContainer) return;
      paypalRendered = true;
      paypal.Buttons({
        createOrder: function () {
          return fetch('/api/paypal/subscription/create-order', {
            method: 'post',
            headers: { 'content-type': 'application/json' }
          })
          .then(res => res.json())
          .then(data => data.id);
        },
        onApprove: function (data) {
          return fetch('/api/paypal/subscription/capture-order', {
            method: 'post',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ orderID: data.orderID })
          })
          .then(res => res.json())
          .then(details => {
            if (details && details.success && details.redirect) {
              window.location.href = details.redirect;
            } else {
              alert('Payment not completed.');
            }
          });
        }
      }).render('#paypal-button-container');
    }

    let subPaynowPoll;
    function stopSubPaynowPoll() {
      if (subPaynowPoll) {
        clearInterval(subPaynowPoll);
        subPaynowPoll = null;
      }
    }
    function sync(){
      const method = paynowRadio.checked ? 'paynow' : (netsRadio.checked ? 'nets' : (paypalRadio.checked ? 'paypal' : 'stripe'));
      walletSections.forEach(section => {
        section.style.display = section.dataset.method === method ? 'block' : 'none';
      });
      if (method === 'paypal' || method === 'paynow') {
        confirmBtn.style.display = 'none';
        if (method === 'paypal') {
          renderPaypalButtons();
        }
      } else {
        confirmBtn.style.display = 'inline-block';
      }
      if (method !== 'paynow') {
        stopSubPaynowPoll();
        if (subPaynowStartBtn) subPaynowStartBtn.disabled = false;
        if (subPaynowStatus) subPaynowStatus.textContent = '';
      }
    }
    stripeRadio.addEventListener('change', sync);
    paynowRadio.addEventListener('change', sync);
    netsRadio.addEventListener('change', sync);
    paypalRadio.addEventListener('change', sync);
    sync();

    // Polls PayNow intent until NETS confirms or the QR expires, then finalizes subscription.
    async function pollSubPaynowStatus(intentId) {
      stopSubPaynowPoll();
      subPaynowPoll = setInterval(async () => {
        try {
          const res = await fetch(`/api/stripe/intent-status/${intentId}`);
          const data = await res.json();
          if (data.status === 'succeeded') {
            stopSubPaynowPoll();
            subPaynowStatus.textContent = 'Payment confirmed. Activating subscription...';
            stripeIntentInput.value = intentId;
            paymentForm.action = '/stripe/subscription/complete';
            paymentForm.submit();
          } else if (data.status === 'canceled' || data.status === 'requires_payment_method') {
            stopSubPaynowPoll();
            subPaynowStatus.textContent = 'Payment failed or expired. Please generate a new QR code.';
            subPaynowStartBtn.disabled = false;
          }
        } catch (e) {
          stopSubPaynowPoll();
          subPaynowStatus.textContent = 'Unable to check payment status.';
          subPaynowStartBtn.disabled = false;
        }
      }, 3000);
    }

    // Triggering PayNow for subscriptions uses the same confirm/paynow flow as cart payments.
    if (subPaynowStartBtn) {
      subPaynowStartBtn.addEventListener('click', async () => {
        subPaynowStartBtn.disabled = true;
        subPaynowStatus.textContent = 'Generating PayNow QR code...';
        subPaynowQrWrap.classList.add('d-none');
        try {
          // 1. Create a PayNow intent tied to the subscription tier.
          const res = await fetch('/api/stripe/subscription-paynow-intent', { method: 'post' });
          let data = null;
          try {
            data = await res.json();
          } catch (e) {
            data = { error: await res.text() };
          }
          if (!res.ok || !data.intentId || !data.clientSecret) {
            subPaynowStatus.textContent = data.message || data.error || `Unable to generate PayNow QR (HTTP ${res.status}).`;
            subPaynowStartBtn.disabled = false;
            return;
          }
          if (!stripeInstance) {
            subPaynowStatus.textContent = 'Stripe is not configured.';
            subPaynowStartBtn.disabled = false;
            return;
          }
          const returnUrl = window.location.origin + '/paynow/return';
          // 2. Confirm PayNow with Stripe, allow it to render the QR or redirect actions.
          const confirmResult = await stripeInstance.confirmPayNowPayment(data.clientSecret, {
            payment_method: {
              billing_details: {
                name: "<%= user && user.username ? user.username.replace(/\"/g, '') : 'Customer' %>",
                email: "<%= user && user.email ? user.email.replace(/\"/g, '') : '' %>"
              }
            },
            return_url: returnUrl
          });
          if (confirmResult.error) {
            subPaynowStatus.textContent = confirmResult.error.message || 'PayNow confirmation failed.';
            subPaynowStartBtn.disabled = false;
            return;
          }
          const pi = confirmResult.paymentIntent;
          if (pi && pi.status === 'succeeded') {
            subPaynowStatus.textContent = 'Payment confirmed. Activating subscription...';
            stripeIntentInput.value = data.intentId;
            paymentForm.action = '/stripe/subscription/complete';
            paymentForm.submit();
            return;
          }
          const nextAction = pi && pi.next_action ? pi.next_action : null;
          const qr = nextAction && (nextAction.paynow_display_qr_code || nextAction.display_qr_code) ? (nextAction.paynow_display_qr_code || nextAction.display_qr_code) : null;
          if (qr && qr.image_url) {
            // 3. Show QR + instructions; start polling intent status until Stripe marks it succeeded.
            subPaynowQrImage.src = qr.image_url;
            subPaynowQrLink.href = qr.hosted_instructions_url || '#';
            subPaynowQrWrap.classList.remove('d-none');
            if (qr.expires_at) {
              const exp = new Date(qr.expires_at * 1000);
              subPaynowExpires.textContent = `Expires at: ${exp.toLocaleTimeString()}`;
            } else {
              subPaynowExpires.textContent = '';
            }
            subPaynowStatus.textContent = 'Waiting for payment confirmation...';
            pollSubPaynowStatus(data.intentId);
            return;
          }
          if (nextAction && nextAction.redirect_to_url && nextAction.redirect_to_url.url) {
            subPaynowStatus.textContent = 'Redirecting to PayNow instructions...';
            window.location.href = nextAction.redirect_to_url.url;
            return;
          }
          subPaynowStatus.textContent = 'PayNow action not available. Please try again.';
          subPaynowStartBtn.disabled = false;
        } catch (e) {
          subPaynowStatus.textContent = 'Unable to start PayNow payment.';
          subPaynowStartBtn.disabled = false;
        }
      });
    }

    // Stripe checkout flow: create session and redirect.
    paymentForm.addEventListener('submit', async (event) => {
      const useStripe = stripeRadio.checked;
      if (!useStripe) return;
      event.preventDefault();
      if (!stripeInstance) {
        alert('Stripe is not configured.');
        return;
      }
      confirmBtn.disabled = true;
      try {
        const res = await fetch('/api/stripe/subscription-checkout-session', {
          method: 'post'
        });
        let data = null;
        try {
          data = await res.json();
        } catch (e) {
          data = { error: await res.text() };
        }
        if (!res.ok || !data.sessionId) {
          alert(data.message || data.error || `Unable to start Stripe checkout (HTTP ${res.status}).`);
          confirmBtn.disabled = false;
          return;
        }
        const redirectResult = await stripeInstance.redirectToCheckout({ sessionId: data.sessionId });
        if (redirectResult.error) {
          alert(redirectResult.error.message || 'Stripe checkout failed.');
          confirmBtn.disabled = false;
        }
      } catch (err) {
        alert('Stripe checkout failed: ' + (err.message || 'unknown error'));
        confirmBtn.disabled = false;
      }
    });
  })();
</script>
<%- include('partials/footer') %>
