<%- include('partials/header', { user, pageTitle: 'Admin Dashboard', currentPage: 'adminDashboard' }) %>
<section class="admin-hero mb-4">
  <div>
    <div class="admin-eyebrow">Admin Console</div>
    <h1 class="admin-title">Dashboard</h1>
    <p class="muted mb-0">Welcome back, <strong><%= user.username %></strong> · <span class="text-uppercase small"><%= user.role %></span></p>
  </div>
  <div class="admin-hero-actions">
    <a class="btn btn-primary" href="/inventory"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4-9 4-9-4z"></path><path d="M3 7v10l9 4 9-4V7"></path><path d="M12 11v10"></path></svg></span>Inventory</a>
    <a class="btn btn-primary" href="/addProduct"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg></span>Add Product</a>
    <a class="btn btn-primary" href="/admin/users"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M16 11a4 4 0 1 0-8 0"></path><path d="M4 20a8 8 0 0 1 16 0"></path><circle cx="12" cy="7" r="3"></circle></svg></span>Users</a>
  </div>
</section>

<% if (typeof pendingRefundCount !== 'undefined' && pendingRefundCount > 0) { %>
  <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-2">
    <span><strong><%= pendingRefundCount %></strong> refund request(s) pending approval.</span>
    <a class="btn btn-sm btn-outline-dark" href="/admin/refund-requests">Review Requests</a>
  </div>
<% } %>

<div class="admin-quick-grid mb-4">
  <a class="admin-quick-card" href="/inventory" aria-label="Manage inventory">
    <div class="quick-icon"><svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4-9 4-9-4z"></path><path d="M3 7v10l9 4 9-4V7"></path><path d="M12 11v10"></path></svg></div>
    <div>
      <h4>Inventory</h4>
      <p>Monitor stock and pricing.</p>
    </div>
  </a>
  <a class="admin-quick-card" href="/addProduct" aria-label="Add product">
    <div class="quick-icon"><svg viewBox="0 0 24 24"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg></div>
    <div>
      <h4>Add Product</h4>
      <p>Publish new items fast.</p>
    </div>
  </a>
  <a class="admin-quick-card" href="/admin/users" aria-label="Manage users">
    <div class="quick-icon"><svg viewBox="0 0 24 24"><path d="M16 11a4 4 0 1 0-8 0"></path><path d="M4 20a8 8 0 0 1 16 0"></path><circle cx="12" cy="7" r="3"></circle></svg></div>
    <div>
      <h4>Users
        <% if (typeof pendingRefundCount !== 'undefined' && pendingRefundCount > 0) { %>
          <span class="badge bg-warning text-dark ms-2"><%= pendingRefundCount %> pending</span>
        <% } %>
      </h4>
      <p>Roles, access, and orders.</p>
    </div>
  </a>
  <a class="admin-quick-card" href="/admin/vouchers" aria-label="Manage vouchers">
    <div class="quick-icon"><svg viewBox="0 0 24 24"><path d="M4 7h16v10H4z"></path><path d="M7 7v10"></path><path d="M17 7v10"></path><circle cx="9.5" cy="12" r="1.4"></circle><circle cx="14.5" cy="12" r="1.4"></circle></svg></div>
    <div>
      <h4>Vouchers</h4>
      <p>Create discount codes for customers.</p>
    </div>
  </a>
  <a class="admin-quick-card" href="/admin/orders/search" aria-label="Search orders">
    <div class="quick-icon"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"></circle><path d="M20 20l-3.5-3.5"></path></svg></div>
    <div>
      <h4>Orders</h4>
      <p>Find orders by reference.</p>
    </div>
  </a>
  <a class="admin-quick-card" href="/logout" aria-label="Logout">
    <div class="quick-icon"><svg viewBox="0 0 24 24"><path d="M10 5h6a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-6"></path><path d="M14 12H4"></path><path d="M8 8l-4 4 4 4"></path></svg></div>
    <div>
      <h4>Logout</h4>
      <p>Secure sign out.</p>
    </div>
  </a>
</div>
<% if (errors && errors.length) { %>
  <div class="alert alert-danger"><%= errors.join(', ') %></div>
<% } %>
<% if (messages && messages.length) { %>
  <div class="alert alert-success"><%= messages.join(', ') %></div>
<% } %>
<%- include('partials/footer') %>



