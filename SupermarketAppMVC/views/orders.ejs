<% /* Orders page: lists user orders and their items (joined from order_items) */ %>
<%- include('partials/header', { user, pageTitle: 'Order History', currentPage: 'orders' }) %>
<h2 class="mb-4">Your Orders</h2>
<% if (!orders.length) { %>
  <div class="alert alert-info">No orders yet. <a href="/shopping">Start shopping</a>.</div>
<% } else { %>
  <div class="list-group">
  <% orders.forEach((o, idx) => { %>
    <% const orderNumber = typeof o.displayNumber !== 'undefined' ? o.displayNumber : (orders.length - idx); %>
    <% const reqStatus = o.refund_request_status ? String(o.refund_request_status).toLowerCase() : ''; %>
    <% const refundState = o.refund_status ? String(o.refund_status).toLowerCase() : ''; %>
    <% const isRefunded = refundState === 'refunded' || refundState === 'succeeded' || refundState === 'completed'; %>
    <% const itemSubtotal = (itemsByOrder[o.id] || []).reduce((s,it)=> s + Number(it.total_price || 0), 0); %>
    <% const voucherAmt = Number(o.voucher_amount || 0); %>
    <% const deliveryFee = Number(o.delivery_fee || 0); %>
    <% const savingsAmount = Number(o.savings_amount || 0); %>
    <% const derivedTotal = (itemSubtotal + deliveryFee - voucherAmt); %>
    <% const recordedTotal = Number(o.total || 0); %>
    <div class="list-group-item mb-3 shadow-sm rounded-md order-card" id="order-<%= o.id %>">
      <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
          <strong>Order #<%= orderNumber %></strong>
          <div class="text-muted small">Order ID: <%= o.id %></div>
          <div class="text-muted small">Placed: <%= new Date(o.created_at).toLocaleString() %></div>
          <div class="small">Method: <%= o.delivery_method %> | Fee: $<%= Number(o.delivery_fee).toFixed(2) %></div>
          <div class="small">Items subtotal: $<%= itemSubtotal.toFixed(2) %></div>
          <% if (voucherAmt > 0) { %>
            <div class="small text-success">Voucher (<%= o.voucher_code || 'Applied' %>): -$<%= voucherAmt.toFixed(2) %></div>
          <% } %>
          <div class="fw-semibold">Total: $<%= derivedTotal.toFixed(2) %></div>
          <% if (savingsAmount > 0) { %>
            <div class="small text-success">Savings this order: $<%= savingsAmount.toFixed(2) %></div>
          <% } %>
          <% if (Math.abs(derivedTotal - recordedTotal) > 0.01) { %>
            <div class="small text-warning">Recorded total differs: $<%= recordedTotal.toFixed(2) %></div>
          <% } %>
        </div>
      </div>
      <div class="mt-2">
        <a class="btn btn-secondary btn-sm" href="/orders/<%= o.id %>/invoice?auto=1">Print Invoice</a>
      </div>
      <hr/>
      <table class="table table-sm">
        <thead>
          <tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Line Total</th></tr>
        </thead>
        <tbody>
          <% (itemsByOrder[o.id] || []).forEach(it => { %>
            <tr>
              <td><%= it.productName %></td>
              <td><%= it.quantity %></td>
              <td>$<%= (Number(it.total_price || 0) / Number(it.quantity || 1)).toFixed(2) %></td>
              <td>$<%= Number(it.total_price || 0).toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="mt-3">
        <% if (isRefunded) { %>
          <div class="small text-success">Refunded successfully: $<%= Number(o.refund_amount || 0).toFixed(2) %></div>
          <% if (o.refunded_at) { %>
            <div class="small text-muted">Refunded on: <%= new Date(o.refunded_at).toLocaleString() %></div>
          <% } %>
        <% } else if (reqStatus === 'pending') { %>
          <div class="small text-warning">Refund request pending review.</div>
        <% } else if (reqStatus === 'denied') { %>
          <div class="small text-danger">Refund request rejected.</div>
          <% if (o.refund_request_note) { %>
            <div class="small text-muted">Admin note: <%= o.refund_request_note %></div>
          <% } %>
        <% } else if (reqStatus === 'approved') { %>
          <div class="small text-success">Refund approved.</div>
          <% if (o.refund_request_note) { %>
            <div class="small text-muted">Admin note: <%= o.refund_request_note %></div>
          <% } %>
        <% } else { %>
          <form action="/orders/<%= o.id %>/refund-request" method="post" class="refund-request">
            <label class="form-label fw-semibold">Request a refund</label>
            <textarea class="form-control mb-2" name="reason" rows="2" required minlength="10" placeholder="Explain the issue (min 10 characters)."></textarea>
            <button class="btn btn-outline-danger btn-sm" type="submit" onclick="return confirm('Submit a refund request for this order?');">Submit Refund Request</button>
          </form>
        <% } %>
      </div>
    </div>
  <% }) %>
  </div>
  <% if (totalPages > 1) { %>
    <nav class="mt-3" aria-label="Orders pagination">
      <ul class="pagination justify-content-center">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="/orders?page=<%= page - 1 %>">Previous</a>
        </li>
        <% for (let p = 1; p <= totalPages; p++) { %>
          <li class="page-item <%= p === page ? 'active' : '' %>">
            <a class="page-link" href="/orders?page=<%= p %>"><%= p %></a>
          </li>
        <% } %>
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="/orders?page=<%= page + 1 %>">Next</a>
        </li>
      </ul>
    </nav>
  <% } %>
<% if (orders && orders.length) { 
     let grand = 0; 
     orders.forEach(o => { grand += Number(o.total) || 0; }); %>
  <div class="mt-4 p-3 rounded-md" style="background:#ffffff; border:1px solid #e2e8f0; box-shadow:0 4px 12px -6px rgba(0,0,0,.05);">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
      <strong class="fs-5">Grand Total</strong>
      <span class="fw-semibold fs-5">$<%= grand.toFixed(2) %></span>
    </div>
    <div class="small text-muted mt-1">Sum of all order totals listed above.</div>
  </div>
<% } %>
<% } %>
<% if (messages && messages.length) { %>
  <div class="alert alert-success mt-3">
    <% messages.forEach(m => { %><div><%= m %></div><% }) %>
  </div>
<% } %>
<% if (errors && errors.length) { %>
  <div class="alert alert-danger mt-3">
    <% errors.forEach(e => { %><div><%= e %></div><% }) %>
  </div>
<% } %>
<%- include('partials/footer') %>
<script>
  // No JS needed; invoice page handles printing when opened with ?auto=1
</script>
<style></style>
