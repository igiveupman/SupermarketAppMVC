<%- include('partials/header', { user, pageTitle: pageTitle, currentPage: 'cart' }) %>
<section class="mb-4">
  <h2 class="mb-2">Scan to Pay (NETS QR)</h2>
  <p class="text-muted mb-3">Use your bank app to scan the QR code and complete payment.</p>
  <div class="d-flex flex-column flex-md-row gap-4 align-items-start">
    <div class="border rounded p-3 bg-white shadow-sm">
      <img src="<%= qrCodeUrl %>" alt="NETS QR Code" style="max-width:240px; width:100%; height:auto;" />
    </div>
    <div class="flex-grow-1">
      <p class="mb-2"><strong>Amount:</strong> $<%= total %></p>
      <p class="mb-2"><strong>Status:</strong> <span id="status">Waiting for payment...</span></p>
      <p class="mb-0 text-muted" id="timer">Time remaining: 5:00</p>
    </div>
  </div>
  <div class="mt-3">
    <a href="<%= typeof cancelUrl !== 'undefined' ? cancelUrl : '/cart' %>" class="btn btn-outline"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 6l-6 6 6 6"></path></svg></span>Cancel</a>
  </div>
</section>

<script>
  (function(){
    const txnRetrievalRef = "<%= txnRetrievalRef %>";
    const statusEl = document.getElementById('status');
    const timerEl = document.getElementById('timer');
    const url = `/sse/payment-status/${txnRetrievalRef}`;

    const sse = new EventSource(url);
    sse.addEventListener('message', (event) => {
      const data = JSON.parse(event.data);
      if (data.success) {
        sse.close();
        window.location.href = `/nets-qr/success?txn_retrieval_ref=${txnRetrievalRef}`;
        return;
      }
      if (data.fail) {
        sse.close();
        window.location.href = `/nets-qr/fail?txn_retrieval_ref=${txnRetrievalRef}`;
        return;
      }
    });

    // Countdown timer
    let remaining = 300;
    const timerInterval = setInterval(() => {
      const minutes = Math.floor(remaining / 60);
      const seconds = remaining % 60;
      timerEl.textContent = `Time remaining: ${minutes}:${seconds.toString().padStart(2, '0')}`;
      remaining -= 1;
      if (remaining < 0) {
        clearInterval(timerInterval);
        statusEl.textContent = 'Timeout';
        sse.close();
        window.location.href = `/nets-qr/fail?txn_retrieval_ref=${txnRetrievalRef}`;
      }
    }, 1000);
  })();
</script>
<%- include('partials/footer') %>
