<% /*
  Admin Users page
  - Lists all users in a clean table
  - Admin accounts are protected (no edit/delete)
  - Provides quick links to edit user or view their order history
*/ %>
<%- include('partials/header', { pageTitle: 'Manage Users', user, currentPage: 'adminUsers', messages, errors }) %>
<section class="admin-form-wrapper users-scene">
  <div class="admin-panel users-panel">
    <div class="users-hero">
      <div>
        <div class="users-eyebrow">Storefront Operations</div>
        <h1 class="users-title">Customer Registry</h1>
        <p class="users-sub">Quickly manage shoppers and view order trails.</p>
      </div>
      <% const totalUsers = (users || []).length; %>
      <% const adminCount = (users || []).filter(u => u.role === 'admin').length; %>
      <% const customerCount = totalUsers - adminCount; %>
      <div class="users-stats">
        <div class="stat-card">
          <div class="stat-label">Total Accounts</div>
          <div class="stat-value"><%= totalUsers %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Customers</div>
          <div class="stat-value"><%= customerCount %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Admins</div>
          <div class="stat-value"><%= adminCount %></div>
        </div>
      </div>
    </div>
    <% /* Flash messages are rendered by the header include; avoid duplicating here. */ %>
    <div class="users-table-wrapper">
      <table class="table table-sm mb-0 users-table">
        <thead>
          <tr>
            <th>Member</th>
            <th>Contact</th>
            <th>Role</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
        <% if (users && users.length) { %>
          <% users.forEach(u => { %>
            <tr class="user-row">
              <td>
                <div class="member-cell">
                  <div class="member-avatar"><%= (u.username || 'U').charAt(0).toUpperCase() %></div>
                  <div>
                    <div class="member-name"><%= u.username %></div>
                    <div class="member-meta">ID <%= u.id %> · <%= u.email %></div>
                  </div>
                </div>
              </td>
              <td>
                <div class="member-contact"><%= u.contact || 'No contact' %></div>
              </td>
              <td>
                <span class="role-pill <%= u.role === 'admin' ? 'role-admin' : 'role-user' %>"><%= u.role %></span>
              </td>
              <td>
                <div class="user-actions" role="group">
                  <% if (u.role !== 'admin') { %>
                    <a href="/admin/users/<%= u.id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit user">
                      <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 17l4 3 12-12-4-4L4 17z"></path><path d="M14 5l4 4"></path></svg></span>Edit
                    </a>
                    <a href="/admin/users/<%= u.id %>/orders" class="btn btn-sm btn-outline-secondary" title="View order history">
                      <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h10v18l-5-3-5 3V3z"></path><path d="M9 8h6"></path><path d="M9 12h6"></path></svg></span>Orders
                    </a>
                    <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Delete user <%= u.username %>?');" class="inline-form">
                      <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete user">
                        <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 7h14"></path><path d="M9 7V5h6v2"></path><path d="M7 7l1 12h8l1-12"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg></span>Delete
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-muted small">Protected admin</span>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4" class="text-center py-4">No users found.</td></tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<!-- Local styles specific to Manage Users page; keep lightweight and scoped -->

<%- include('partials/footer') %>

