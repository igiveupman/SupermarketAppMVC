<% /* Shopping page header: includes FairPrice-inspired navbar */ %>
<%- include('partials/header', { user, pageTitle: 'Shop', currentPage: 'shopping' }) %>
<% const __trendingMode = (typeof trendingMode !== 'undefined') ? trendingMode : false; %>
<% const currentSearch = typeof search !== 'undefined' ? search : ''; %>
<% const currentCategory = typeof category !== 'undefined' ? category : ''; %>

<section class="shop-shell">
  <div class="shop-hero">
    <div>
      <div class="shop-eyebrow">Welcome, <strong><%= user.username %></strong> <small>(<%= user.role %>)</small></div>
      <h2 class="shop-title">Fresh Picks, Daily</h2>
      <p class="shop-sub">Discover essentials, seasonal finds, and member favourites in one clean aisle.</p>
    </div>
    <div class="shop-hero-card">
      <div class="hero-chip"><span>Today’s highlight</span> <strong>Seasonal savings</strong></div>
      <div class="hero-note">Use vouchers for dairy and pantry staples.</div>
    </div>
  </div>

  <% if (__trendingMode) { %>
    <div class="trend-banner">Showing trending (featured) products only.</div>
  <% } %>

  <% /* Category chips */ %>
  <div class="shop-categories">
    <% const categories = [
      { key: '', label: 'All', iconSrc: '/images/logo.png', iconClass: 'icon-logo' },
      { key: 'Bakery', label: 'Bakery', iconSrc: '/images/bread.png' },
      { key: 'Dairy', label: 'Dairy', iconSrc: '/images/milk.png' },
      { key: 'Produce', label: 'Fruits & Veg', iconSrc: '/images/broccoli.png' },
      { key: 'Meats', label: 'Meats', iconSrc: '/images/beef.jpg' }
    ]; %>
    <% const buildQuery = (params) => {
         const parts = [];
         if (params.category) parts.push('category=' + encodeURIComponent(params.category));
         if (params.search) parts.push('search=' + encodeURIComponent(params.search));
         if (params.trending) parts.push('trending=1');
         return parts.length ? '?' + parts.join('&') : '';
       }; %>
    <a class="cat-pill <%= __trendingMode ? 'active' : '' %>" href="/shopping<%= __trendingMode ? buildQuery({ search: currentSearch, category: currentCategory }) : buildQuery({ trending: true, search: currentSearch, category: currentCategory }) %>">
      <span class="cat-icon"><img src="/images/apples.png" alt="" aria-hidden="true"></span>
      Trending
    </a>
    <% categories.forEach(c => { %>
      <a class="cat-pill <%= (currentCategory === c.key || (!currentCategory && c.key === '')) ? 'active' : '' %>" href="/shopping<%= (currentCategory === c.key) ? buildQuery({ search: currentSearch, trending: __trendingMode }) : buildQuery({ category: c.key, search: currentSearch, trending: __trendingMode }) %>">
        <span class="cat-icon"><img src="<%= c.iconSrc %>" alt="" aria-hidden="true"></span>
        <%= c.label %>
      </a>
    <% }) %>
  </div>

  <form class="shop-filter" method="GET" action="/shopping">
    <div class="filter-field">
      <label class="form-label">Search</label>
      <input type="text" name="search" class="form-control" placeholder="Search products..." value="<%= currentSearch %>">
    </div>
    <div class="filter-field">
      <label class="form-label">Category</label>
      <select name="category" class="form-select">
        <option value="">All Categories</option>
        <option value="Bakery" <%= currentCategory === 'Bakery' ? 'selected' : '' %>>Bakery</option>
        <option value="Dairy" <%= currentCategory === 'Dairy' ? 'selected' : '' %>>Dairy</option>
        <option value="Fruits and Vegetables" <%= (currentCategory === 'Produce' || currentCategory === 'Fruits and Vegetables') ? 'selected' : '' %>>Fruits and Vegetables</option>
        <option value="Meats" <%= currentCategory === 'Meats' ? 'selected' : '' %>>Meats</option>
      </select>
    </div>
    <label class="filter-check">
      <input class="form-check-input" type="checkbox" name="trending" value="1" <%= __trendingMode ? 'checked' : '' %> />
      Trending only
    </label>
    <div class="filter-actions">
      <button type="submit" class="btn btn-primary btn-pill">Filter</button>
      <a href="/shopping" class="btn btn-link">Reset</a>
    </div>
  </form>
</section>

<div class="products-grid">
  <% if (!__trendingMode && typeof trendingProducts !== 'undefined' && trendingProducts.length) { %>
    <div style="grid-column:1/-1">
      <div class="section-title"><span>Trending Products</span></div>
      <div class="products-grid trending-grid">
        <% trendingProducts.forEach(tp => { %>
          <%- include('partials/productCard', { p: tp, user, showFavorite: true, clickable: true, returnTo: '/shopping' }) %>
        <% }) %>
      </div>
      <hr class="mt-4">
    </div>
  <% } %>
  <% if (__trendingMode && products.length === 0) { %>
    <div style="grid-column:1/-1" class="center muted mt-4">No trending products right now.</div>
  <% } %>
  <% products.forEach(p => { %>
    <%- include('partials/productCard', { p, user, showFavorite: true, clickable: true, returnTo: '/shopping' }) %>
  <% }) %>
</div>

<% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
  <nav class="mt-4">
    <ul class="pagination">
      <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="/shopping?page=<%= page - 1 %><%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %><%= currentCategory ? '&category=' + encodeURIComponent(currentCategory) : '' %><%= __trendingMode ? '&trending=1' : '' %>" tabindex="-1">Previous</a>
      </li>
      <% for (let i=1;i<= totalPages;i++){ %>
        <li class="page-item <%= page === i ? 'active' : '' %>">
          <a class="page-link" href="/shopping?page=<%= i %><%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %><%= currentCategory ? '&category=' + encodeURIComponent(currentCategory) : '' %><%= __trendingMode ? '&trending=1' : '' %>"><%= i %></a>
        </li>
      <% } %>
      <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="/shopping?page=<%= page + 1 %><%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %><%= currentCategory ? '&category=' + encodeURIComponent(currentCategory) : '' %><%= __trendingMode ? '&trending=1' : '' %>">Next</a>
      </li>
    </ul>
    <p class="text-muted small mt-2">Page <%= page %> of <%= totalPages %></p>
  </nav>
<% } %>

<%- include('partials/footer') %>
<script src="/js/cartAjax.js"></script>
<script>
  document.addEventListener('click', function(e){
    const card = e.target.closest('.product-card.clickable');
    if (!card) return;
    if (e.target.tagName === 'A' || e.target.tagName === 'BUTTON' || e.target.closest('form')) return;
    let link = card.getAttribute('data-link');
    if (link) {
      if ((link.startsWith('"') && link.endsWith('"')) || (link.startsWith("'") && link.endsWith("'"))) {
        link = link.slice(1, -1);
      }
      window.location.assign(link);
    }
  });
  document.addEventListener('input', function(e){
    if (e.target.matches('.qty-input')) {
      const maxAttr = e.target.getAttribute('data-max') || e.target.getAttribute('max');
      const max = parseInt(maxAttr,10) || 0;
      const val = parseInt(e.target.value,10) || 0;
      if (val > max) {
        e.target.classList.add('is-invalid');
        if (!e.target.nextElementSibling || !e.target.nextElementSibling.classList.contains('qty-error')) {
          const msg = document.createElement('div');
          msg.className = 'qty-error text-danger small';
          msg.textContent = 'Not enough stock (max ' + max + ').';
          e.target.parentNode.appendChild(msg);
        } else {
          e.target.nextElementSibling.textContent = 'Not enough stock (max ' + max + ').';
        }
      } else {
        e.target.classList.remove('is-invalid');
        if (e.target.nextElementSibling && e.target.nextElementSibling.classList.contains('qty-error')) {
          e.target.nextElementSibling.remove();
        }
      }
    }
  });
  document.addEventListener('submit', function(e){
    if (e.target.matches('form[action^="/add-to-cart/"]')) {
      const input = e.target.querySelector('.qty-input');
      if (input) {
        const maxAttr = input.getAttribute('data-max') || input.getAttribute('max');
        const max = parseInt(maxAttr,10) || 0;
        const val = parseInt(input.value,10) || 0;
        if (val > max) {
          e.preventDefault();
          alert('Not enough stock. Available: ' + max);
        }
      }
    }
  });
</script>


