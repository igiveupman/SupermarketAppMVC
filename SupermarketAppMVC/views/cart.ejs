<% /* Cart page: lists session cart items, remove actions, and checkout */ %>
<%- include('partials/header', { user, pageTitle: 'Cart', currentPage: 'cart' }) %>
<h2 class="mb-4">Your Cart</h2>
<% if (cart.length === 0) { %>
  <div class="alert alert-info">Your cart is empty.</div>
  <a href="/shopping" class="btn btn-primary"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 7h12l-1 10H7L6 7z"></path><path d="M9 7a3 3 0 1 1 6 0"></path><path d="M8 21h8"></path></svg></span>Click here to Shop</a>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-clean align-middle">
      <thead>
        <tr>
          <th>Product</th>
          <th>Image</th>
          <th>Quantity</th>
          <th>Unit Price</th>
          <th>Line Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% cart.forEach(item => { %>
          <tr>
            <td><%= item.productName %></td>
            <td style="width:110px"><img src="/images/<%= item.image %>" class="img-fluid rounded" alt="<%= item.productName %>"></td>
            <td>
              <form action="/cart/update/<%= item.productId %>" method="post" class="d-flex align-items-center">
                <input type="number" name="quantity" class="form-control form-control-sm" style="width:90px" min="1" value="<%= item.quantity %>" onchange="this.form.submit()">
              </form>
            </td>
            <td>
              <% if (item.subscriptionDiscountApplied) { %>
                <span class="text-success fw-semibold">$<%= Number(item.effectivePrice).toFixed(2) %></span>
                <small class="text-muted text-decoration-line-through ms-1">$<%= Number(item.price).toFixed(2) %></small>
                <small class="text-muted ms-1">Member -<%= Math.round(item.subscriptionDiscountRate * 100) %>%</small>
              <% } else if (item.discountApplied) { %>
                <span class="text-danger fw-semibold">$<%= Number(item.price).toFixed(2) %></span>
                <small class="text-muted text-decoration-line-through ms-1">$<%= Number(item.originalPrice).toFixed(2) %></small>
              <% } else { %>
                $<%= Number(item.price).toFixed(2) %>
              <% } %>
            </td>
            <td>$<%= Number(item.lineTotal).toFixed(2) %></td>
            <td><a href="/cart/remove/<%= item.productId %>" class="btn btn-sm btn-remove"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 7h14"></path><path d="M9 7V5h6v2"></path><path d="M7 7l1 12h8l1-12"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg></span>Remove</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
    <div class="fw-semibold">
      <div>Subtotal: $<%= pricing.subtotal.toFixed(2) %></div>
      <% if (pricing.voucherAmount > 0) { %>
        <div class="text-success">Voucher (<%= pricing.voucherCode %>): -$<%= Number(pricing.voucherAmount).toFixed(2) %></div>
      <% } %>
      <div>
        Delivery fee:
        <% if (pricing.deliveryFee > 0) { %>
          $<%= pricing.deliveryFee.toFixed(2) %>
        <% } else { %>
          $0.00 <span class="text-success small ms-1">Free delivery applied</span>
        <% } %>
      </div>
      <div class="mt-1">Total: $<%= pricing.total.toFixed(2) %></div>
    </div>
    <div class="voucher-panel">
      <% if (pricing.voucherAmount > 0) { %>
        <div class="small text-success mb-2">Voucher applied: <strong><%= pricing.voucherCode %></strong></div>
        <form action="/cart/voucher/remove" method="post" class="d-inline">
          <input type="hidden" name="returnTo" value="/cart" />
          <button class="btn btn-outline btn-sm" type="submit">Remove Voucher</button>
        </form>
      <% } else { %>
        <a class="btn btn-voucher" href="/vouchers"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16v10H4z"></path><path d="M7 7v10"></path><path d="M17 7v10"></path><circle cx="9.5" cy="12" r="1.4"></circle><circle cx="14.5" cy="12" r="1.4"></circle></svg></span>Choose Voucher</a>
        <div class="voucher-hint">Apply from your vouchers list.</div>
      <% } %>
    </div>
    <div>
  <a href="/purchase" class="btn btn-quick"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 7h14l-2 10H7L5 7z"></path><path d="M9 7a3 3 0 1 1 6 0"></path><path d="M12 13h4"></path></svg></span>Purchase</a>
      <a href="/shopping" class="btn btn-continue ms-2"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 7h12l-1 10H7L6 7z"></path><path d="M9 7a3 3 0 1 1 6 0"></path><path d="M8 21h8"></path></svg></span>Continue Shopping</a>
      <form action="/cart/clear" method="post" class="d-inline ms-2" onsubmit="return confirm('Clear all items from your cart?');">
        <button type="submit" class="btn btn-danger"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 7h14"></path><path d="M9 7V5h6v2"></path><path d="M7 7l1 12h8l1-12"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg></span>Clear Cart</button>
      </form>
    </div>
  </div>
<% } %>
<%- include('partials/footer') %>
