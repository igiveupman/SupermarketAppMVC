<%- include('partials/header', { user, pageTitle: 'User Orders', currentPage: 'adminUsers', messages: (typeof messages !== 'undefined' ? messages : []), errors: (typeof errors !== 'undefined' ? errors : []) }) %>
<div class="container-wide">
  <div class="admin-orders-header">
    <div class="admin-orders-title">
      <div class="eyebrow">User Orders</div>
      <h2><%= subjectUser.username %></h2>
      <div class="subline"><%= subjectUser.email %></div>
    </div>
    <div class="admin-orders-actions">
      <a class="btn btn-outline" href="/admin/users"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 6l-6 6 6 6"></path></svg></span>Back to Users</a>
      <form action="/admin/users/<%= subjectUser.id %>/orders/clear" method="post" onsubmit="return confirm('Clear all orders for this user? This cannot be undone.');">
        <button class="btn btn-danger" type="submit"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 7h14"></path><path d="M9 7V5h6v2"></path><path d="M7 7l1 12h8l1-12"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg></span>Clear Order History</button>
      </form>
    </div>
  </div>

  <% if (!orders.length) { %>
    <div class="alert alert-info">No orders found for this user.</div>
  <% } else { %>
    <div class="list-group">
      <% orders.forEach((o, idx) => { %>
        <% const orderNumber = typeof o.displayNumber !== 'undefined' ? o.displayNumber : (orders.length - idx); %>
        <% const provider = (o.payment_provider || o.delivery_method || '').toLowerCase(); %>
        <% const isRefunded = o.refund_status && String(o.refund_status).toLowerCase() === 'refunded'; %>
        <% const reqStatus = o.refund_request_status ? String(o.refund_request_status).toLowerCase() : ''; %>
        <% const refundTypeMap = { item_not_received: 'Item not received', item_damaged: 'Item arrived damaged', wrong_item: 'Wrong item received', changed_mind: 'Changed mind', other: 'Other' }; %>
        <% const refundTypeLabel = o.refund_request_type ? (refundTypeMap[o.refund_request_type] || o.refund_request_type) : null; %>
        <div class="list-group-item mb-3">
          <div class="d-flex justify-content-between">
            <div>
              <strong>Order #<%= orderNumber %></strong> - <span class="text-muted"><%= new Date(o.created_at || o.createdAt).toLocaleString() %></span>
            </div>
            <div>
              <a class="btn btn-sm btn-outline-primary" href="/orders/<%= o.id %>/invoice" target="_blank">View Invoice</a>
            </div>
          </div>
          <table class="table table-sm mt-2">
            <thead>
              <tr>
                <th>Item</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Price</th>
                <th class="text-end">Total</th>
              </tr>
            </thead>
            <tbody>
              <% (itemsByOrder[o.id] || []).forEach(it => { %>
                <tr>
                  <td><%= it.productName %></td>
                  <td class="text-end"><%= it.quantity %></td>
                  <td class="text-end">$<%= (Number(it.total_price || 0) / Number(it.quantity || 1)).toFixed(2) %></td>
                  <td class="text-end">$<%= Number(it.total_price || 0).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="small text-muted">
              Payment: <strong><%= (o.payment_provider || o.delivery_method || 'unknown').toUpperCase() %></strong>
              <% if (o.payment_reference) { %>
                <span class="ms-2">Ref: <%= o.payment_reference %></span>
              <% } %>
              <% if (o.refund_status) { %>
                <span class="badge bg-success ms-2">Refunded</span>
              <% } else if (reqStatus === 'pending') { %>
                <span class="badge bg-warning text-dark ms-2">Refund Requested</span>
              <% } %>
            </div>
            <% if (o.refund_status) { %>
              <div class="small">
                Refund: $<%= Number(o.refund_amount || 0).toFixed(2) %>
                <% if (o.refunded_at) { %>
                  <span class="text-muted ms-2"><%= new Date(o.refunded_at).toLocaleString() %></span>
                <% } %>
              </div>
            <% } else if (reqStatus === 'pending') { %>
              <% if (refundTypeLabel) { %>
                <div class="w-100 small text-muted mt-2">Request type: <%= refundTypeLabel %></div>
              <% } %>
              <div class="w-100 small text-muted mt-1">Request: <%= o.refund_request_reason || 'No reason provided' %></div>
              <div class="d-flex align-items-center gap-2 flex-wrap mt-2">
                <form action="/admin/orders/<%= o.id %>/refund/approve" method="post" class="d-flex align-items-center gap-2" onsubmit="return confirm('Approve and process this refund?');">
                  <input class="form-control form-control-sm" type="number" name="amount" step="0.01" min="0.01" max="<%= Number(o.total).toFixed(2) %>" value="<%= Number(o.refund_request_amount || o.total).toFixed(2) %>" style="max-width:120px;" />
                  <input class="form-control form-control-sm" type="text" name="note" placeholder="Approval note (optional)" style="max-width:220px;" />
                  <button class="btn btn-sm btn-outline-success" type="submit">Approve</button>
                </form>
                <form action="/admin/orders/<%= o.id %>/refund/deny" method="post" class="d-flex align-items-center gap-2" onsubmit="return confirm('Deny this refund request?');">
                  <input class="form-control form-control-sm" type="text" name="note" placeholder="Denial reason (optional)" style="max-width:220px;" />
                  <button class="btn btn-sm btn-outline-danger" type="submit">Deny</button>
                </form>
              </div>
            <% } else if (provider === 'stripe' || provider === 'paypal') { %>
              <form action="/admin/orders/<%= o.id %>/refund" method="post" class="d-flex align-items-center gap-2" onsubmit="return confirm('Refund this order?');">
                <input class="form-control form-control-sm" type="number" name="amount" step="0.01" min="0.01" max="<%= Number(o.total).toFixed(2) %>" value="<%= Number(o.total).toFixed(2) %>" style="max-width:120px;" />
                <input class="form-control form-control-sm" type="text" name="note" placeholder="Reason (optional)" style="max-width:220px;" />
                <button class="btn btn-sm btn-outline-danger" type="submit">Refund</button>
              </form>
            <% } else { %>
              <span class="small text-muted">Refunds for NETS/PayNow are manual.</span>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
    <% if (totalPages > 1) { %>
      <nav class="mt-3" aria-label="Orders pagination">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/admin/users/<%= subjectUser.id %>/orders?page=<%= page - 1 %>">Previous</a>
          </li>
          <% for (let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= p === page ? 'active' : '' %>">
              <a class="page-link" href="/admin/users/<%= subjectUser.id %>/orders?page=<%= p %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/admin/users/<%= subjectUser.id %>/orders?page=<%= page + 1 %>">Next</a>
          </li>
        </ul>
      </nav>
    <% } %>
  <% } %>
</div>
<%- include('partials/footer') %>


