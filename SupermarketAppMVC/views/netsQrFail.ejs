<%- include('partials/header', { user, pageTitle: pageTitle, currentPage: 'cart' }) %>
<section class="mb-4">
  <h2 class="mb-2">NETS QR Payment Failed</h2>
  <p class="text-muted mb-3">We couldn't complete your payment. Please try again.</p>
  <div class="border rounded p-3 bg-white">
    <p class="mb-1"><strong>Response Code:</strong> <%= responseCode %></p>
    <% if (instructions) { %>
      <p class="mb-1"><strong>Instructions:</strong> <%= instructions %></p>
    <% } %>
    <p class="mb-0"><strong>Details:</strong> <%= errorMsg %></p>
  </div>
  <div class="mt-3">
    <a href="/purchase" class="btn btn-primary"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 6l-6 6 6 6"></path></svg></span>Back to Payment</a>
    <a href="/cart" class="btn btn-outline ms-2"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 6l-6 6 6 6"></path></svg></span>Back to Cart</a>
  </div>
</section>
<%- include('partials/footer') %>
