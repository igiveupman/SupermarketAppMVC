<%- include('partials/header', { user, pageTitle: 'My Vouchers', currentPage: 'vouchers', messages, errors }) %>
<div class="voucher-hero">
  <div>
    <div class="voucher-eyebrow">Member Rewards</div>
    <h2 class="voucher-title">My Vouchers</h2>
    <p class="muted mb-0">Use vouchers at checkout to reduce your cart total.</p>
  </div>
  <a class="btn btn-outline" href="/cart"><span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 7h12l-1 10H7L6 7z"></path><path d="M9 7a3 3 0 1 1 6 0"></path><path d="M8 21h8"></path></svg></span>Go to Cart</a>
</div>

<div class="voucher-section">
  <h3>Available</h3>
  <% if (!available.length) { %>
    <div class="alert alert-info">No active vouchers right now.</div>
  <% } else { %>
    <div class="voucher-grid">
      <% available.forEach(v => { %>
        <% const tooLarge = Number(v.amount) > Number(cartSubtotal || 0); %>
        <% const isApplied = applied && applied.code === v.code; %>
        <div class="voucher-card">
          <div class="voucher-code"><%= v.code %></div>
          <div class="voucher-amount">-$<%= Number(v.amount).toFixed(2) %></div>
          <div class="voucher-meta">
            <span>Expires: <%= new Date(v.expires_at).toLocaleDateString() %></span>
            <span><%= v.user_id ? 'Personal' : 'Global' %></span>
          </div>
          <div class="voucher-actions">
            <% if (isApplied) { %>
              <span class="badge bg-success">Applied</span>
            <% } else { %>
              <form action="/cart/voucher/apply" method="post">
                <input type="hidden" name="code" value="<%= v.code %>" />
                <input type="hidden" name="returnTo" value="/vouchers" />
                <button class="btn btn-sm btn-primary" type="submit" <%= tooLarge ? 'disabled' : '' %>>Apply to Cart</button>
              </form>
            <% } %>
            <% if (tooLarge) { %>
              <div class="small text-muted mt-2">Add more items to cart to use this voucher.</div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<div class="voucher-section">
  <h3>Unavailable</h3>
  <% if (!redeemed.length) { %>
    <div class="alert alert-info">No used vouchers yet.</div>
  <% } else { %>
    <div class="voucher-grid">
      <% redeemed.forEach(r => { %>
        <div class="voucher-card disabled">
          <div class="voucher-code"><%= r.code %></div>
          <div class="voucher-amount">-$<%= Number(r.amount).toFixed(2) %></div>
          <div class="voucher-meta">
            <span>Used on: <%= new Date(r.redeemed_at).toLocaleDateString() %></span>
            <span>Order #<%= r.order_id %></span>
          </div>
          <div class="voucher-actions">
            <span class="badge bg-secondary">Redeemed</span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
